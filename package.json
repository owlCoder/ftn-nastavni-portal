{
  "name": "ftn-nastavni-portal",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "npm run generate:practicum && node scripts/generate-example-zips.mjs",
    "dev": "vite",
    "prebuild": "npm run generate:practicum && node scripts/generate-example-zips.mjs && npm run check:course-files",
    "generate:practicum": "node scripts/generate-practicum-markdown.mjs",
    "check:materials-sync": "node scripts/check-materials-sync.mjs",
    "build": "tsc -b && vite build",
    "check:course-files": "node scripts/check-course-files.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
